# Placement mode: fill weights x the per-DS connector assessment.
# Needs ENABLE_DS_CONNECTOR=ON and a lattice-ds-connector on THIS MDS.
placement_mode = smart
ds_capacity_poll_ms = 30000
placement_capacity_max_age_ms = 90000
ds_connector_socket = /run/lattice-ds-connector/connector.sock
ds_connector_poll_ms = 1000
ds_connector_request_deadline_ms = 500
ds_connector_expected_contract_major = 1
# optional pins (verify prints the digests every MDS sees):
# ds_connector_expected_profiles = xinas-mvp=sha256:...
# ds_connector_expected_config_digest = sha256:...
