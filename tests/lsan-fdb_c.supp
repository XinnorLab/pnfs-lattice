#
# lsan-fdb_c.supp -- LeakSanitizer suppressions for the FoundationDB
# client library.
#
# The fdb_c client keeps process-lifetime allocations (network thread
# arenas, cluster connection state) that fdb_stop_network() does not
# release; LeakSanitizer reports them as direct leaks whose every frame
# is inside libfdb_c.so.  They are the library's, not the catalogue
# backend's: a leak in src/catalogue/catalogue_fdb*.c, fdb_txn.c or
# fdb_codec.c has a frame in this tree and is still reported.
#
# Usage:
#   LSAN_OPTIONS=suppressions=tests/lsan-fdb_c.supp ./build-asan/tests/test_fdb_ext

leak:libfdb_c.so
